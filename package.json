{
  "name": "bb-plugin-instabox",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "InstaBox machines (instabox.sh) as bb machines, connected over InstaBox's own SSH gateway. Experimental.",
  "engines": {
    "bb": ">=0.45",
    "bbPluginSdk": ">=0.6.15"
  },
  "bb": {
    "name": "InstaBox",
    "description": "Run bb threads on InstaBox machines enrolled as bb machines, without Tailscale (experimental).",
    "branding": {
      "icon": "./instabox.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.104",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "hono": "^4.13.16",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p .",
    "build": "bb plugin build"
  }
}
